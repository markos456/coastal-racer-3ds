; Coastal Racer 3DS — vertex shader (PICA200)
.uniform invec4 projection[4]
.uniform invec4 modelView[4]
.uniform invec4 uColor

.in invec4 position
.out vec4 outColor

.constf invec4 vscale = { 1.0, -1.0, 0.5, 0.0 }
.constf invec4 vtrans = { 0.0,  0.0, 0.5, 0.0 }

.code
    dp4 r0.x, position, modelView[0]
    dp4 r0.y, position, modelView[1]
    dp4 r0.z, position, modelView[2]
    dp4 r0.w, position, modelView[3]

    dp4 r1.x, r0, projection[0]
    dp4 r1.y, r0, projection[1]
    dp4 r1.z, r0, projection[2]
    dp4 r1.w, r0, projection[3]

    mul r1.xy, r1.xy, vscale.xy
    mul r1.z,  r1.z,  vscale.z
    add r1.z,  r1.z,  vtrans.z

    mov outpos, r1
    mov outColor, uColor
    end
